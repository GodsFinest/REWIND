{
  "name": "rewind",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "description": "Local-first backup and evidence-driven recovery console",
  "author": "REWIND",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/build-native.mjs && node scripts/dev.mjs",
    "build": "node scripts/build-native.mjs && tsc --noEmit && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run tests/*.test.ts",
    "test:integration": "node scripts/build-native.mjs && vitest run tests/integration.test.ts tests/crash.test.ts tests/lab-recovery.test.ts",
    "format": "prettier --write apps/desktop/*.{ts,tsx,css} packages/core/{lab,requests}.ts packages/evaluation/run.ts scripts/ui-smoke.mjs tests/lab-recovery.test.ts",
    "format:check": "prettier --check apps/desktop/*.{ts,tsx,css} packages/core/{lab,requests}.ts packages/evaluation/run.ts scripts/ui-smoke.mjs tests/lab-recovery.test.ts",
    "evaluate": "node scripts/build-native.mjs && tsx packages/evaluation/run.ts",
    "demo": "node scripts/build-native.mjs && tsx packages/cli/index.ts demo .rewind/cli-demo",
    "cli": "node scripts/build-native.mjs && tsx packages/cli/index.ts",
    "package": "npm run build && electron-builder --dir",
    "start": "electron .",
    "test:ui": "npm run build && node scripts/ui-smoke.mjs",
    "postinstall": "node scripts/build-native.mjs",
    "test:package": "node --import tsx scripts/package-smoke.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "45.2.3",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^16.5.0",
    "prettier": "3.6.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^7.3.0",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "local.rewind.desktop",
    "productName": "REWIND",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "target": "dir",
      "identity": null
    },
    "linux": {
      "target": "dir"
    },
    "win": {
      "target": "dir"
    },
    "extraResources": [
      {
        "from": "native/bin/rewind-publish",
        "to": "rewind-publish"
      }
    ]
  },
  "overrides": {
    "minimatch": "11.0.5"
  }
}
